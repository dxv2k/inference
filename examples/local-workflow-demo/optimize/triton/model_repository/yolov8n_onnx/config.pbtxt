# Triton model config for YOLOv8n exported via Ultralytics → ONNX (imgsz=640).
# Drop the exported file at: yolov8n_onnx/1/model.onnx
#
# Tensor names ("images", "output0") match Ultralytics' default ONNX export.
# Verify with `onnxinfo yolov8n_onnx/1/model.onnx` or `polygraphy inspect model`.

name: "yolov8n_onnx"
platform: "onnxruntime_onnx"
max_batch_size: 32

input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP32
    dims: [300, 6]   # NMS folded into the graph: each row is [x1,y1,x2,y2,conf,cls];
                     # exported with `nms=True`, exactly 300 rows per image (zero-padded).
  }
]

# Aggregate inflight requests from N camera workers into batched GPU calls.
# Tune preferred_batch_size to your steady-state camera count.
# max_queue_delay_microseconds = 50ms: the window Triton waits for more
# requests before dispatching. Too small (e.g. 5ms) and sparse traffic never
# batches; too large and per-frame latency suffers. 50ms is a reasonable
# compromise for ~30-camera deployments at ~5fps each.
dynamic_batching {
  preferred_batch_size: [8, 16]
  max_queue_delay_microseconds: 5000
}

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]
