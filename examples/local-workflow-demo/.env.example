# Copy to .env (gitignored) and fill in your real values.
# The Tab 8 auto-annotate-v2 workflow uses Gemini via OpenRouter to suggest
# detection classes for the YOLO-World v2 detector.

# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model ID on OpenRouter. The default below matches what was requested.
# If the ID changes upstream, swap it without touching code.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
