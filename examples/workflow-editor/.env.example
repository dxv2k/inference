# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# If you've already set up `../local-workflow-demo/.env`, the simplest thing
# is to copy that file here:
#     cp ../local-workflow-demo/.env .env
#
# Only the `vlm_only` builtin workflow (and any custom workflow using the
# `roboflow_core/openai_compatible@v1` block) actually reads these. Everything
# else runs without them.

OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
